# Токен от @BotFather
BOT_TOKEN=
# Строка подключения MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/lunchbot
# Telegram ID повара (можно несколько через запятую)
ADMIN_IDS=123456789
# Цена пакета для команды /pack и стартового меню
PACK_PRICE=40000
CURRENCY=сум
# Часовой пояс для «сегодняшних» заказов (Ташкент = 5)
TZ_OFFSET_HOURS=5

# Публичный HTTPS-адрес сервера (хостинг или туннель ngrok/cloudflared).
# Нужен для Mini App и webhook. Пусто = бот в режиме polling, Mini App только в браузере.
PUBLIC_URL=
PORT=3000
# Самопинг /health раз в N минут, чтобы бесплатный Render не засыпал.
# По умолчанию 10 при NODE_ENV=production и заданном PUBLIC_URL, 0 = выключить
KEEP_ALIVE_MINUTES=

# Только для разработки: открыть Mini App в обычном браузере от имени этого Telegram ID
DEV_USER_ID=
